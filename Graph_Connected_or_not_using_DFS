#include <stdio.h>

int visited[20];

void DFS(int adj[][20], int n, int v) {
    int i;
    visited[v] = 1;
    for(i = 1; i <= n; i++) {
        if(adj[v][i] == 1 && visited[i] == 0)
            DFS(adj, n, i);
    }
}

int main() {
    int n, i, j, adj[20][20];

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 1; i <= n; i++)
        for(j = 1; j <= n; j++)
            scanf("%d", &adj[i][j]);

    
    for(i = 1; i <= n; i++)
        visited[i] = 0;

    DFS(adj, n, 1);     

    
    for(i = 1; i <= n; i++) {
        if(visited[i] == 0) {
            printf("Graph is NOT Connected");
            return 0;
        }
    }
    printf("Graph IS Connected");
    return 0;
}
