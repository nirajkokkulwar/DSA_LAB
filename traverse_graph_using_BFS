#include <stdio.h>
#include <stdlib.h>

int queue[20], front = 0, rear = -1;
int visited[20];

void BFS(int adj[][20], int n, int start) {
    int i, j;
    
    
    for(i = 1; i <= n; i++)
        visited[i] = 0;

   
    visited[start] = 1;
    queue[++rear] = start;

    printf("BFS Traversal: ");

    while(front <= rear) {
        int v = queue[front++];
        printf("%d ", v);

        for(j = 1; j <= n; j++) {
            if(adj[v][j] == 1 && visited[j] == 0) {
                queue[++rear] = j;
                visited[j] = 1;
            }
        }
    }
}

int main() {
    int n, i, j, start, adj[20][20];

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");
    for(i = 1; i <= n; i++)
        for(j = 1; j <= n; j++)
            scanf("%d", &adj[i][j]);

    printf("Enter starting vertex: ");
    scanf("%d", &start);

    BFS(adj, n, start);
    return 0;
}
